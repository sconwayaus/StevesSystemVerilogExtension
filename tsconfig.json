{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true
  },
  "exclude": [
    "node_modules",
    "bin"
  ]
}
