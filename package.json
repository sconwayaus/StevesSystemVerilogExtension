{
	"name": "steves-system-verilog-extension",
	"displayName": "StevesSystemVerilogExtension",
	"description": "Steve's System Verilog Extension",
	"author": "Steve Conway",
	"license": "MIT",
	"version": "0.3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/sconwayaus/StevesSystemVerilogExtension"
	},
	"publisher": "SteveCreations",
	"categories": [
		"Programming Languages",
		"Linters",
		"Formatters",
		"Snippets"
	],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.90.0"
	},
	"main": "./dist/extension.js",
	"icon": "images/icon.png",
	"contributes": {
		"languages": [
			{
				"id": "systemverilog",
				"extensions": [
					".sv"
				],
				"aliases": [
					"systemverilog",
					"System Verilog",
					"Systemverilog"
				],
				"configuration": "./configs/systemVerilog.json",
				"icon": {
					"light": "./resources/sv_light.svg",
					"dark": "./resources/sv_dark.svg"
				}
			},
			{
				"id": "systemverilogheader",
				"aliases": [
					"SystemVerilogHeader",
					"systemverilogheader",
					"System Verilog Header",
					"Systemverilogheader"
				],
				"extensions": [
					".svh"
				],
				"configuration": "./configs/systemVerilog.json",
				"icon": {
					"light": "./resources/svh_light.svg",
					"dark": "./resources/svh_dark.svg"
				}
			},
			{
				"id": "verilog",
				"aliases": [
					"Verilog",
					"verilog"
				],
				"extensions": [
					".v"
				],
				"configuration": "./configs/systemVerilog.json",
				"icon": {
					"light": "./resources/v_light.svg",
					"dark": "./resources/v_dark.svg"
				}
			},
			{
				"id": "verilogheader",
				"aliases": [
					"VerilogHeader",
					"verilogheader"
				],
				"extensions": [
					".vh"
				],
				"configuration": "./configs/systemVerilog.json",
				"icon": {
					"light": "./resources/vh_light.svg",
					"dark": "./resources/vh_dark.svg"
				}
			},
			{
				"id": "verilog-filelist",
				"aliases": [
					"Verilog Filelist",
					"verilog-filelist",
					"Dot-F File"
				],
				"extensions": [
					".f"
				],
				"configuration": "./configs/verilogFileList.json",
				"icon": {
					"light": "./resources/f_light.svg",
					"dark": "./resources/f_dark.svg"
				}
			},
			{
				"id": "sdc",
				"aliases": [
					"SDC",
					"Synopsys Design Constraints"
				],
				"extensions": [
					".sdc"
				],
				"configuration": "./configs/tcl.json",
				"icon": {
					"light": "./resources/sdc_light.svg",
					"dark": "./resources/sdc_dark.svg"
				}
			},
			{
				"id": "xdc",
				"aliases": [
					"XDC",
					"Xilinx Design Constraints"
				],
				"extensions": [
					".xdc"
				],
				"configuration": "./configs/tcl.json",
				"icon": {
					"light": "./resources/sdc_light.svg",
					"dark": "./resources/sdc_dark.svg"
				}
			},
			{
				"id": "qip",
				"aliases": [
					"QIP",
					"Quartus IP File"
				],
				"extensions": [
					".qip"
				],
				"configuration": "./configs/tcl.json",
				"icon": {
					"light": "./resources/sdc_light.svg",
					"dark": "./resources/sdc_dark.svg"
				}
			},
			{
				"id": "qsf",
				"aliases": [
					"QSF",
					"Quartus Settings File"
				],
				"extensions": [
					".qsf"
				],
				"configuration": "./configs/tcl.json",
				"icon": {
					"light": "./resources/sdc_light.svg",
					"dark": "./resources/sdc_dark.svg"
				}
			},
			{
				"id": "tcl",
				"aliases": [
					"TCL",
					"Tool Command Language"
				],
				"extensions": [
					".tcl"
				],
				"configuration": "./configs/tcl.json",
				"icon": {
					"light": "./resources/sdc_light.svg",
					"dark": "./resources/sdc_dark.svg"
				}
			},
			{
				"id": "pd",
				"extensions": [
					".pd"
				],
				"configuration": "./configs/pd.json"
			}
		],
		"snippets": [
			{
				"language": "systemverilog",
				"path": "./snippets/systemverilog.jsonc"
			},
			{
				"language": "verilog",
				"path": "./snippets/systemverilog.jsonc"
			},
			{
				"language": "systemverilogheader",
				"path": "./snippets/systemverilog.jsonc"
			},
			{
				"language": "verilogheader",
				"path": "./snippets/systemverilog.jsonc"
			},
			{
				"language": "sdc",
				"path": "./snippets/sdc.json"
			},
			{
				"language": "xdc",
				"path": "./snippets/xdc.json"
			},
			{
				"language": "qsf",
				"path": "./snippets/qsf.json"
			},
			{
				"language": "qip",
				"path": "./snippets/qip.json"
			},
			{
				"language": "tcl",
				"path": "./snippets/tcl.jsonc"
			}
		],
		"grammars": [
			{
				"language": "systemverilog",
				"scopeName": "source.systemverilog",
				"path": "./syntaxes/systemverilog.tmLanguage.json"
			},
			{
				"language": "verilog",
				"scopeName": "source.systemverilog",
				"path": "./syntaxes/systemverilog.tmLanguage.json"
			},
			{
				"language": "systemverilogheader",
				"scopeName": "source.systemverilog",
				"path": "./syntaxes/systemverilog.tmLanguage.json"
			},
			{
				"language": "verilogheader",
				"scopeName": "source.systemverilog",
				"path": "./syntaxes/systemverilog.tmLanguage.json"
			},
			{
				"language": "verilog-filelist",
				"scopeName": "source.verilog-filelist",
				"path": "./syntaxes/verilog-filelist.json"
			},
			{
				"language": "sdc",
				"scopeName": "source.sdc",
				"path": "./syntaxes/sdc.tmLanguage"
			},
			{
				"language": "xdc",
				"scopeName": "source.xdc",
				"path": "./syntaxes/xdc.tmLanguage"
			},
			{
				"language": "qip",
				"scopeName": "source.qip",
				"path": "./syntaxes/qip.tmLanguage"
			},
			{
				"language": "qsf",
				"scopeName": "source.qsf",
				"path": "./syntaxes/qsf.tmLanguage"
			},
			{
				"language": "tcl",
				"scopeName": "source.tcl",
				"path": "./syntaxes/tcl.tmLanguage"
			},
			{
				"language": "pd",
				"scopeName": "source.pd",
				"path": "./syntaxes/pd.tmLanguage"
			}
		],
		"activationEvents": [
			"onLanguage:systemverilog",
			"onLanguage:verilog",
			"onLanguage:systemverilogheader",
			"onLanguage:verilogheader",
			"onLanguage:verilog-filelist",
			"onLanguage:sdc",
			"onLanguage:xdc",
			"onLanguage:qip",
			"onLanguage:qsf",
			"onLanguage:tcl"
		],
		"configuration": {
			"type": "object",
			"title": "Steve's System Verilog Extension",
			"properties": {
				"stevesSystemVerilogExtension.rules_config.svn_path": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "SVN path to a directory containing verible.filelist and verible language server.\nExample: https://server/repos/trunk/verible_rules",
					"order": 1
				},
				"stevesSystemVerilogExtension.languageServer.arguments": {
					"type": "array",
					"default": [],
					"items": {
						"type": "string"
					},
					"scope": "machine",
					"description": "Arguments for verible-verilog-ls server.",
					"order": 2
				},
				"stevesSystemVerilogExtension.projectFileList.includeGlobPattern": {
					"type": "string",
					"default": "{**/*.sv,**/*.*v,**/*.svh}",
					"scope": "machine-overridable",
					"description": "Include file glob pattern for creating a project file list (verible.filelist).",
					"order": 3
				},
				"stevesSystemVerilogExtension.projectFileList.excludeGlobPattern": {
					"type": "string",
					"default": "{**/db/*,**/incremental_db/*,**/output/*}",
					"scope": "machine-overridable",
					"description": "Exclude file glob pattern for creating a project file list (verible.filelist).",
					"order": 4
				},
				"stevesSystemVerilogExtension.update.ignoredExtensions": {
					"type": "array",
					"default": [],
					"scope": "machine",
					"description": "A json list of extensions that the user has ignored.",
					"order": 5
				}
			}
		},
		"commands": [
			{
				"command": "stevesSystemVerilogExtension.create_project_file_list",
				"title": "StevesSystemVerilogExtension: Create Project File List (verible.filelist)"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p -w . --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"vsix": "vsce package"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/decompress": "^4.2.7",
		"@types/follow-redirects": "^1.14.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.5",
		"@types/vscode": "^1.144.0",
		"@typescript-eslint/eslint-plugin": "^8.18.0",
		"@typescript-eslint/parser": "^8.18.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.1.0",
		"esbuild": "^0.28.2",
		"esbuild-loader": "^4.5.0",
		"eslint": "^10.14.0",
		"mocha": "^11.0.0",
		"ts-loader": "^9.6.2",
		"typescript": "5.5",
		"typescript-eslint": "^8.72.1",
		"webpack": "^5.112.2",
		"webpack-cli": "^7.2.3"
	},
	"dependencies": {
		"decompress-targz": "^4.1.1",
		"follow-redirects": "^1.16.2",
		"glob": "^14.0.3",
		"semver": "^7.8.5",
		"vscode-languageclient": "^10.0.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"@vscode/vsce-sign@2.1.0": true
	},
	"overrides": {
		"minimatch": "^11.0.1",
		"glob": "^14.0.3",
		"cross-spawn": "^6.0.6",
		"diff": "^8.0.3",
		"serialize-javascript": "^7.1.3",
		"tmp": "^0.2.6",
		"@typescript-eslint/parser": {
			"typescript": "$typescript"
		},
		"@typescript-eslint/eslint-plugin": {
			"typescript": "$typescript"
		}
	}
}
